 #include "sub/osd.h"
 #include "gpu_next/context.h"
 
+// Folio: draw into buffers the host app hands over, instead of the
+// swapchain. Set with --folio-target=<address of a struct folio_target>;
+// the host keeps the struct alive while the player exists. All three
+// callbacks run on the VO thread.
+//  - allowed: drawing may touch the GPU now (false while the app is in the
+//    background without Picture in Picture: iOS refuses GPU work then).
+//    Checked before anything else in a draw, so a skipped frame does no GPU
+//    work at all.
+//  - acquire: a buffer of w x h to draw into, as an id<MTLTexture> on the
+//    system's default Metal device (usage: render target), or NULL to skip
+//    this frame. *fmt: 0 = bgra8 (SDR), 1 = rgba16f (HDR). *trc: 0 = SDR,
+//    1 = PQ, 2 = HLG (BT.2020). *token: handed back to present.
+//  - present: the GPU has finished drawing into the buffer (ok) or it
+//    won't be (not ok); pts is the frame's, in seconds.
+struct folio_target {
+    void *ctx;
+    bool (*allowed)(void *ctx);
+    void *(*acquire)(void *ctx, int w, int h, int *fmt, int *trc, void **token);
+    void (*present)(void *ctx, void *token, double pts, bool ok);
+};
