+static struct folio_target *folio_target(struct priv *p)
+{
+    return (struct folio_target *)(intptr_t)p->next_opts->folio_target;
+}
+
+// Hands the buffer in flight back to the host, drawn (ok) or not.
+static void folio_finish(struct priv *p, struct folio_target *ft, bool ok)
+{
+    if (!p->ft_tex && !p->ft_token)
+        return;
+    if (ok)
+        pl_gpu_finish(p->gpu); // complete before the host's layer reads it
+    pl_tex_destroy(p->gpu, &p->ft_tex);
+    void *token = p->ft_token;
+    p->ft_token = NULL;
+    if (ft && ft->present)
+        ft->present(ft->ctx, token, p->ft_pts, ok);
+}
+
+// The host's buffer as this frame's target, in place of a swapchain image.
+static bool folio_start_frame(struct vo *vo, struct priv *p,
+                              struct folio_target *ft,
+                              struct pl_swapchain_frame *out)
+{
+    int w = vo->dwidth, h = vo->dheight;
+    if (w <= 0 || h <= 0 || !ft->acquire)
+        return false;
+    if (!(p->gpu->import_caps.tex & PL_HANDLE_MTL_TEX)) {
+        MP_ERR(vo, "folio-target: this GPU can't import Metal textures\n");
+        return false;
+    }
+    int fmt = 0, trc = 0;
+    void *token = NULL;
+    void *mtl = ft->acquire(ft->ctx, w, h, &fmt, &trc, &token);
+    if (!mtl) {
+        if (token && ft->present)
+            ft->present(ft->ctx, token, 0, false);
+        return false;
+    }
+    pl_fmt plfmt = pl_find_named_fmt(p->gpu, fmt == 1 ? "rgba16f" : "bgra8");
+    pl_tex tex = NULL;
+    if (plfmt) {
+        tex = pl_tex_create(p->gpu, &(struct pl_tex_params) {
+            .w = w,
+            .h = h,
+            .format = plfmt,
+            .renderable = true,
+            .blit_dst = !!(plfmt->caps & PL_FMT_CAP_BLITTABLE),
+            .import_handle = PL_HANDLE_MTL_TEX,
+            .shared_mem = (struct pl_shared_mem) {
+                .handle = { .handle = mtl },
+            },
+        });
+    }
+    if (!tex) {
+        MP_ERR(vo, "folio-target: couldn't use the host's %dx%d %s buffer\n",
+               w, h, fmt == 1 ? "rgba16f" : "bgra8");
+        if (ft->present)
+            ft->present(ft->ctx, token, 0, false);
+        return false;
+    }
+    p->ft_tex = tex;
+    p->ft_token = token;
+    p->ft_valid = false;
+    *out = (struct pl_swapchain_frame) {
+        .fbo = tex,
+        .flipped = false,
+        .color_repr = pl_color_repr_rgb,
+        .color_space = trc == 1 ? pl_color_space_hdr10
+                     : trc == 2 ? pl_color_space_bt2020_hlg
+                     : pl_color_space_monitor,
+    };
+    return true;
+}
